[0.000, "o", "\u001b[1m╔════════════════════════════════════════════════════════════════╗\u001b[0m\r\n"]
[0.000, "o", "\u001b[1m║  MCP Server — Loomi QA · Demo dos 7 tools (3 mandatórias + 4)  ║\u001b[0m\r\n"]
[0.000, "o", "\u001b[1m╚════════════════════════════════════════════════════════════════╝\u001b[0m\r\n"]
[1.207, "o", "\r\n\u001b[1;36m# 1. Verificar build do MCP\u001b[0m\r\n"]
[1.215, "o", "-rw-r--r--@ 1 filipegabriel  staff  1917  2 mai 19:35 mcp-server/dist/index.js\r\n"]
[0.000, "o", "\u001b[1;32m✓ build presente\u001b[0m\r\n"]
[1.208, "o", "\r\n\u001b[1;36m# 2. tools/list — listar os 7 tools expostos\u001b[0m\r\n\u001b[1;33m$ echo '{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/list\"}' | node mcp-server/dist/index.js | jq '.result.tools | map(.name)'\u001b[0m\r\n"]
[1.425, "o", "\u001b[1;39m[\r\n  \u001b[0;32m\"run_test_case\"\u001b[0m\u001b[1;39m,\r\n  \u001b[0;32m\"get_element_status\"\u001b[0m\u001b[1;39m,\r\n  \u001b[0;32m\"navigate_to\"\u001b[0m\u001b[1;39m,\r\n  \u001b[0;32m\"list_test_cases\"\u001b[0m\u001b[1;39m,\r\n  \u001b[0;32m\"get_test_history\"\u001b[0m\u001b[1;39m,\r\n  \u001b[0;32m\"extract_dom_snapshot\"\u001b[0m\u001b[1;39m,\r\n  \u001b[0;32m\"analyze_failure\"\u001b[0m\u001b[1;39m\r\n\u001b[1;39m]\u001b[0m\r\n"]
[1.211, "o", "\r\n\u001b[1;36m# 3. resources/list — registry inicial vazio\u001b[0m\r\n"]
[0.000, "o", "\u001b[1;33m$ echo '{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"resources/list\"}' | node mcp-server/dist/index.js | jq '.result'\u001b[0m\r\n"]
[1.439, "o", "\u001b[1;39m{\r\n  \u001b[0m\u001b[1;34m\"resources\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[1;39m[]\u001b[0m\u001b[1;39m\r\n\u001b[1;39m}\u001b[0m\r\n"]
[1.211, "o", "\r\n\u001b[1;36m# 4. tools/call — list_test_cases (extra) — descoberta dinâmica\u001b[0m\r\n\u001b[1;33m$ tools/call name=list_test_cases\u001b[0m\r\n"]
[1.432, "o", "\u001b[1;39m{\r\n  \u001b[0m\u001b[1;34m\"total\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;39m56\u001b[0m\u001b[1;39m,\r\n  \u001b[0m\u001b[1;34m\"primeiros_5\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[1;39m[\r\n    \u001b[1;39m{\r\n      \u001b[0m\u001b[1;34m\"name\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"@a11y ${r.label} sem violations serious/critical\"\u001b[0m\u001b[1;39m,\r\n      \u001b[0m\u001b[1;34m\"file\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"automation/tests/a11y/pages.spec.ts\"\u001b[0m\u001b[1;39m,\r\n      \u001b[0m\u001b[1;34m\"tags\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[1;39m[\r\n"]
