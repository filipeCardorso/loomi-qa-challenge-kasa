[0.000, "o", "    \u001b[1;39m{\r\n"]
[0.000, "o", "      \u001b[0m\u001b[1;34m\"name\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"@api retorna 200 e envelope paginado válido\"\u001b[0m\u001b[1;39m,\r\n      \u001b[0m\u001b[1;34m\"file\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"automation/tests/api/endpoint-match-ended.spec.ts\"\u001b[0m\u001b[1;39m,\r\n      \u001b[0m\u001b[1;34m\"tags\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[1;39m[\r\n        \u001b[0;32m\"@api\"\u001b[0m\u001b[1;39m\r\n      \u001b[1;39m]\u001b[0m\u001b[1;39m\r\n    \u001b[1;39m}\u001b[0m\u001b[1;39m,\r\n    \u001b[1;39m{\r\n      \u001b[0m\u001b[1;34m\"name\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"API GET /match/?status=INPLAY\"\u001b[0m\u001b[1;39m,\r\n      \u001b[0m\u001b[1;34m\"file\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"automation/tests/api/endpoint-match-inplay.spec.ts\"\u001b[0m\u001b[1;39m,\r\n      \u001b[0m\u001b[1;34m\"tags\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[1;39m[]\u001b[0m\u001b[1;39m\r\n    \u001b[1;39m}\u001b[0m\u001b[1;39m,\r\n    \u001b[1;39m{\r\n      \u001b[0m\u001b[1;34m\"name\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"@api retorna 200 e envelope válido (results pode ser vazio)\"\u001b[0m\u001b[1;39m,\r\n      \u001b[0m\u001b[1;34m\"file\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"automation/tests/api/endpoint-match-inplay.spec.ts\"\u001b[0m\u001b[1;39m,\r\n      \u001b[0m\u001b[1;34m\"tags\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[1;39m[\r\n        \u001b[0;32m\"@api\"\u001b[0m\u001b[1;39m\r\n      \u001b[1;39m]\u001b[0m\u001b[1;39m\r\n"]
[0.000, "o", "    \u001b[1;39m}\u001b[0m\u001b[1;39m\r\n  \u001b[1;39m]\u001b[0m\u001b[1;39m\r\n\u001b[1;39m}\u001b[0m\r\n"]
[1.208, "o", "\r\n\u001b[1;36m# 5. tools/call — get_test_history (extra) — sem histórico ainda\u001b[0m\r\n"]
[0.000, "o", "\u001b[1;33m$ tools/call name=get_test_history limit=3\u001b[0m\r\n"]
